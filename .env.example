# DueMate Dashboard Environment Variables

# API base URL (empty for same-origin in dev, full URL in production)
VITE_API_URL=

# Bot WhatsApp number for display in login flow
VITE_BOT_NUMBER=+92 XXX XXXXXXX

# VAPID public key for web push (must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=
